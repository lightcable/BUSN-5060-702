# ---- Required generic parameters ----
DEFAULT_MODEL=deepseek
MODEL_PROFILES=deepseek,pro,qwen,kimi,gemini
DEEPSEEK_FAMILY=deepseek,pro
AGENT_MODELS=orchestrator:kimi,synthesizer:kimi,critic:kimi,researcher:pro,competitor:pro,arbiter:gemini,fact_check:pro
TEMPERATURE=0.2
MAX_ITERATIONS=10
INTERNAL_DOCS_DIR=./internal_docs

# ---- Generated report output (skills + main.py) ----
REPORTS_DIR=reports

# ---- Strategic inputs (optional; empty question skips the run) ----
CASE_FILE=CASE.md

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_INPUT_PRICE_PER_M=0.27
DEEPSEEK_OUTPUT_PRICE_PER_M=1.10

# ---- DeepSeek Pro (reasoner) ----
PRO_MODEL=deepseek-reasoner
PRO_REASONING_EFFORT=max
PRO_INPUT_PRICE_PER_M=0.55
PRO_OUTPUT_PRICE_PER_M=2.19

# ---- Qwen ----
QWEN_API_KEY=sk-...
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_REASONING_EFFORT=max
QWEN_INPUT_PRICE_PER_M=0.80
QWEN_OUTPUT_PRICE_PER_M=2.00

# ---- Kimi (Moonshot) ----
KIMI_API_KEY=sk-...
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_REASONING_EFFORT=max
KIMI_INPUT_PRICE_PER_M=0.0
KIMI_OUTPUT_PRICE_PER_M=0.0

# ---- Gemini (Google, OpenAI-compatible endpoint) ----
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_REASONING_EFFORT=high
GEMINI_INPUT_PRICE_PER_M=0.075
GEMINI_OUTPUT_PRICE_PER_M=0.30
